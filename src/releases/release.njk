---
pagination:
  data: releases
  size: 1
  alias: release
permalink: "/{{ release.slug }}/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
    <title>TrajDali - {{ release.title }}</title>
    {% include "head.njk" %}
    <style>
        {% include "base-styles.njk" %}

        html, body {
            padding: 0;
            margin: 0;
            font-family: 'Roboto Condensed', sans-serif;
            color: #231f20;
        }

        section {
            padding: 0 5vw;
            box-sizing: border-box;
        }

        .release-container {
            width: 100%;
            min-height: 100vh;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4rem;
            padding: 2rem;
        }

        .release-cover {
            flex: 1.3;
            max-width: min(55%, 86vh);
            aspect-ratio: 1;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            view-transition-name: cover-image;
        }

        .release-cover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            view-transition-name: cover-image;
        }

        .release-info {
            flex: 1;
            text-transform: uppercase;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .release-title {
            font-size: 4rem;
            margin-bottom: 0.5rem;
        }

        .release-type {
            font-size: 1.5rem;
            color: #666;
        }

        .release-year {
            font-size: 1.5rem;
            color: #888;
        }

        .release-description {
            font-size: 1.2rem;
            line-height: 1.6;
            color: #444;
            margin: 1rem 0;
            text-transform: none;
        }

        .release-tracks {
            font-size: 1.5rem;
            margin-top: 1rem;
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        .release-track {
            display: flex;
            align-items: center;
            padding: 1rem 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
            transition: background-color 0.3s ease;
            cursor: pointer;
            padding: 0.75rem 1rem;
        }

        .release-track:hover {
            background-color: rgba(0, 0, 0, 0.05);
        }

        .release-track.active {
            background-color: rgba(0, 0, 0, 0.04);
        }

        .release-track.active .release-track-number {
            color: #231f20;
            font-weight: 700;
        }

        .release-track.active .release-track-name {
            font-weight: 700;
        }

        .release-track:last-child {
            border-bottom: none;
        }

        .release-track-number {
            width: 3rem;
            color: #666;
        }

        .release-track-name {
            flex: 1;
        }

        .release-track-length {
            color: #666;
        }

        .streaming-platforms {
            margin-top: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .streaming-title {
            font-size: 1.2rem;
            color: #666;
            margin-bottom: 0.5rem;
        }

        .streaming-buttons {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .streaming-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            text-decoration: none;
            background-color: #f5f5f5;
            transition: all 0.3s ease;
            position: relative;
        }

        .streaming-button:hover {
            transform: translateY(-2px);
            background-color: #e0e0e0;
        }

        .streaming-button img {
            width: 24px;
            height: 24px;
            filter: grayscale(100%);
            opacity: 0.7;
            transition: all 0.3s ease;
        }

        .streaming-button:hover img {
            opacity: 1;
        }

        .play-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background-color: #231f20;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

        .play-button:hover {
            transform: scale(1.05);
            background-color: #000;
        }

        .play-button svg {
            width: 32px;
            height: 32px;
            fill: currentColor;
        }

        .audio-player {
            width: 100%;
            height: 4px;
            background-color: #f5f5f5;
            border-radius: 2px;
            margin-top: 1rem;
            cursor: pointer;
            position: relative;
        }

        .audio-progress {
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            background-color: #231f20;
            border-radius: 2px;
            width: 0%;
            transition: width 0.1s linear;
        }

        .audio-time {
            display: flex;
            justify-content: space-between;
            margin-top: 0.5rem;
            font-size: 0.9rem;
            color: #666;
        }

        .vinyl-button {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.6rem 1.5rem;
            background-color: transparent;
            border: 1px solid rgba(35, 31, 32, 0.3);
            color: #231f20;
            text-decoration: none;
            border-radius: 50px;
            font-size: 0.85rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            transition: all 0.3s ease;
            align-self: flex-start;
        }

        .analog-section {
            margin-top: 2rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .analog-title {
            font-size: 1.2rem;
            color: #666;
        }

        .analog-description {
            color: #666;
            line-height: 1.6;
            font-size: 0.7rem;
            margin-bottom: 1rem;
            text-transform: none;
        }

        .vinyl-button:hover {
            transform: translateY(-2px);
            border-color: #231f20;
            background-color: #231f20;
            color: #fff;
        }

        .vinyl-button svg {
            width: 18px;
            height: 18px;
            fill: currentColor;
            flex-shrink: 0;
        }

        @media screen and (max-width: 900px) {
            body, html {
                overflow-x: hidden;
            }

            nav .links {
                display: none;
            }

            .burger-menu {
                display: flex;
            }

            section {
                padding: 0 1rem;
            }

            .release-container {
                flex-direction: column;
                gap: 2rem;
                padding: 14vh 0.5rem 4vh;
            }

            .release-cover {
                flex: none;
                width: 100%;
                max-width: 100%;
            }

            .release-title {
                font-size: 2.5rem;
            }

            .release-type, .release-year, .release-tracks {
                font-size: 1.2rem;
            }

            .streaming-buttons {
                justify-content: center;
            }

            .play-button {
                margin: 0 auto 1rem;
            }
        }
    </style>
</head>
<body>
    {% include "nav.njk" %}
    <section>
        <div class="release-container">
            <div class="release-cover">
                <img src="/{{ release.slug }}/{{ release.slug }}-480.jpg"
                     srcset="/{{ release.slug }}/{{ release.slug }}-480.jpg 480w,
                             /{{ release.slug }}/{{ release.slug }}-768.jpg 768w,
                             /{{ release.slug }}/{{ release.slug }}-1200.jpg 1200w,
                             /{{ release.slug }}/{{ release.slug }}-2048.jpg 2048w"
                     sizes="(max-width: 900px) 100vw, 50vw"
                     alt="{{ release.title }} Cover">
            </div>
            <div class="release-info">
                <div class="release-title">{{ release.title }}</div>
                <div class="release-type">{{ release.type }}</div>
                <div class="release-year">{{ release.year }}</div>
                <div class="release-description">{{ release.description }}</div>
                <div class="release-tracks">
                    {% for track in release.tracks %}
                    <div class="release-track" data-index="{{ loop.index0 }}">
                        <div class="release-track-number">{{ track.number }}</div>
                        <div class="release-track-name">{{ track.name }}</div>
                        <div class="release-track-length">{{ track.duration }}</div>
                    </div>
                    {% endfor %}
                </div>
                <button class="play-button">
                    <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </button>
                <div class="audio-player">
                    <div class="audio-progress"></div>
                </div>
                <div class="audio-time">
                    <span class="current-time">0:00</span>
                    <span class="duration">{{ release.tracks[0].duration }}</span>
                </div>
                <div class="streaming-platforms">
                    <div class="streaming-title">Listen on</div>
                    <div class="streaming-buttons">
                        {% if release.streaming.spotify %}
                        <a href="{{ release.streaming.spotify }}" target="_blank" class="streaming-button">
                            <img src="/icons/spotify.svg" alt="Spotify">
                        </a>
                        {% endif %}
                        {% if release.streaming.soundcloud %}
                        <a href="{{ release.streaming.soundcloud }}" target="_blank" class="streaming-button">
                            <img src="/icons/soundcloud.svg" alt="SoundCloud">
                        </a>
                        {% endif %}
                        {% if release.streaming.appleMusic %}
                        <a href="{{ release.streaming.appleMusic }}" target="_blank" class="streaming-button">
                            <img src="/icons/apple-music.svg" alt="Apple Music">
                        </a>
                        {% endif %}
                        {% if release.streaming.youtube %}
                        <a href="{{ release.streaming.youtube }}" target="_blank" class="streaming-button">
                            <img src="/icons/youtube.svg" alt="YouTube">
                        </a>
                        {% endif %}
                        {% if release.streaming.bandcamp %}
                        <a href="{{ release.streaming.bandcamp }}" target="_blank" class="streaming-button">
                            <img src="/icons/bandcamp.svg" alt="Bandcamp">
                        </a>
                        {% endif %}
                    </div>
                </div>
                {% if release.vinyl %}
                <div class="analog-section">
                    <div class="analog-title">Or, if you fancy the analog route</div>
                    <div class="analog-description">Because there is nothing quite like the ritual of pulling a record from the sleeve, dropping the needle, and getting lost in the album art.</div>
                    <a href="{{ release.vinyl }}" target="_blank" class="vinyl-button">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                        </svg>
                        Buy Vinyl
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </section>

    <script>
        const playlist = [
            {% for track in release.tracks %}
            { src: '/{{ release.slug }}/{{ track.audio }}', duration: '{{ track.duration }}' }{% if not loop.last %},{% endif %}
            {% endfor %}
        ];

        let currentIndex = 0;
        let isPlaying = false;
        const audio = new Audio(playlist[0].src);

        const audioPlayer = document.querySelector('.audio-player');
        const audioProgress = audioPlayer.querySelector('.audio-progress');
        const audioTime = document.querySelector('.audio-time');
        const currentTimeEl = audioTime.querySelector('.current-time');
        const durationEl = audioTime.querySelector('.duration');
        const playButton = document.querySelector('.play-button');
        const trackRows = document.querySelectorAll('.release-track');

        const PLAY_ICON = '<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
        const PAUSE_ICON = '<svg viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/></svg>';

        function formatTime(seconds) {
            const m = Math.floor(seconds / 60);
            const s = Math.floor(seconds % 60);
            return m + ':' + s.toString().padStart(2, '0');
        }

        function setActiveTrack(index) {
            trackRows.forEach(row => row.classList.remove('active'));
            trackRows[index].classList.add('active');
            durationEl.textContent = playlist[index].duration;
            currentTimeEl.textContent = '0:00';
            audioProgress.style.width = '0%';
            currentIndex = index;
        }

        function loadAndPlay(index) {
            setActiveTrack(index);
            audio.src = playlist[index].src;
            audio.play();
            isPlaying = true;
            playButton.innerHTML = PAUSE_ICON;
        }

        playButton.addEventListener('click', () => {
            if (isPlaying) {
                audio.pause();
                playButton.innerHTML = PLAY_ICON;
            } else {
                audio.play();
                playButton.innerHTML = PAUSE_ICON;
            }
            isPlaying = !isPlaying;
        });

        trackRows.forEach((row, index) => {
            row.addEventListener('click', () => {
                if (index === currentIndex && isPlaying) {
                    audio.pause();
                    isPlaying = false;
                    playButton.innerHTML = PLAY_ICON;
                } else {
                    loadAndPlay(index);
                }
            });
        });

        audio.addEventListener('timeupdate', () => {
            const progress = (audio.currentTime / audio.duration) * 100;
            audioProgress.style.width = progress + '%';
            currentTimeEl.textContent = formatTime(audio.currentTime);
        });

        audio.addEventListener('ended', () => {
            if (currentIndex < playlist.length - 1) {
                loadAndPlay(currentIndex + 1);
            } else {
                isPlaying = false;
                playButton.innerHTML = PLAY_ICON;
                setActiveTrack(0);
                audio.src = playlist[0].src;
            }
        });

        audioPlayer.addEventListener('click', (e) => {
            const rect = audioPlayer.getBoundingClientRect();
            const percentage = (e.clientX - rect.left) / rect.width;
            audio.currentTime = percentage * audio.duration;
        });
    </script>
    {% include "scripts.njk" %}
</body>
</html>
