<!DOCTYPE html>
<html lang="en">
<head>
    <title>TrajDali | Contact</title>
    {% include "head.njk" %}
    <style>
        {% include "base-styles.njk" %}

        html, body {
            padding: 0;
            margin: 0;
            font-family: 'Roboto Condensed', sans-serif;
            color: #231f20;
            scroll-snap-type: y mandatory;
        }

        section {
            height: 80vh;
            padding: 10vh;
            scroll-snap-align: start;
            min-block-size: 80vh;
            scroll-snap-stop: always;
        }

        section .content {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #contact .content .email-address {
            font-size: 3rem;
        }

        #contact .content .contact-details {
            position: relative;
        }

        #contact .content .contact-details p:first-child {
            position: absolute;
            top: 1rem;
        }

        @media screen and (max-width: 900px) {
            body, html {
                overflow-x: hidden;
            }

            nav .links {
                display: none;
            }

            .burger-menu {
                display: flex;
            }

            #contact .content .contact-details p:first-child {
                top: 0rem;
            }

            #contact .content .email-address {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    {% include "nav.njk" %}
    <section id="contact">
        <div class="content">
            <div class="contact-details">
                <p>for inquiries shoot an email to</p>
                <p class="email-address">&#116;&#114;&#097;&#106;&#100;&#097;&#108;&#105;&#064;&#103;&#109;&#097;&#105;&#108;&#046;&#099;&#111;&#109;</p>
            </div>
        </div>
    </section>
    {% include "scripts.njk" %}
</body>
</html>
