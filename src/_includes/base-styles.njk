nav {
    position: absolute;
    top: 0;
    height: 10vh;
    width: calc(100% - 10vw);
    display: flex;
    justify-content: space-between;
    padding: 0 5%;
    z-index: 1000;
}

nav #logo {
    max-height: 150%;
    margin-top: 1%;
    flex: 1;
    max-width: calc(100% - 35px);
}

nav .links {
    flex: 1;
    padding: 1.5%;
    display: flex;
    justify-content: end;
}

nav .links a {
    padding: 1% 5%;
    text-decoration: none;
    color: inherit;
    font-size: 2rem;
}

nav .links a:last-child {
    padding-right: 0;
}

#logo img {
    max-height: 150%;
}

.burger-menu {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 30px;
    height: 21px;
    cursor: pointer;
    z-index: 1001;
    margin-top: 5vh;
}

.burger-menu span {
    display: block;
    width: 100%;
    height: 3px;
    background-color: #231f20;
    transition: all 0.3s ease;
}

.mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: white;
    z-index: 999;
    padding: 10vh 2rem;
    box-sizing: border-box;
}

.mobile-menu .links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
}

.mobile-menu .links a {
    font-size: 2rem;
    text-decoration: none;
    color: inherit;
}

.mobile-menu.active {
    display: block;
}

.burger-menu.active span:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
}

.burger-menu.active span:nth-child(2) {
    opacity: 0;
}

.burger-menu.active span:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
}

@keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
}

@keyframes slide-from-right {
    from { transform: translateX(100px); }
    to { transform: translateX(0); }
}

@keyframes slide-to-left {
    from { transform: translateX(0); }
    to { transform: translateX(-100px); }
}

@keyframes scale-up {
    from { transform: scale(1); }
    to { transform: scale(1.5); }
}

@keyframes scale-down {
    from { transform: scale(1.5); }
    to { transform: scale(1); }
}

::view-transition-old(cover-image) {
    animation: 800ms cubic-bezier(0.4, 0, 0.2, 1) both fade-out,
               800ms cubic-bezier(0.4, 0, 0.2, 1) both slide-to-left,
               800ms cubic-bezier(0.4, 0, 0.2, 1) both scale-down;
}

::view-transition-new(cover-image) {
    animation: 800ms cubic-bezier(0.4, 0, 0.2, 1) both fade-in,
               800ms cubic-bezier(0.4, 0, 0.2, 1) both slide-from-right,
               800ms cubic-bezier(0.4, 0, 0.2, 1) both scale-up;
}

::view-transition-old(mix-thumbnail) {
    animation: 800ms cubic-bezier(0.4, 0, 0.2, 1) both fade-out,
               800ms cubic-bezier(0.4, 0, 0.2, 1) both slide-to-left,
               800ms cubic-bezier(0.4, 0, 0.2, 1) both scale-down;
}

::view-transition-new(mix-thumbnail) {
    animation: 800ms cubic-bezier(0.4, 0, 0.2, 1) both fade-in,
               800ms cubic-bezier(0.4, 0, 0.2, 1) both slide-from-right,
               800ms cubic-bezier(0.4, 0, 0.2, 1) both scale-up;
}
